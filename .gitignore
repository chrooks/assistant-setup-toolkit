# Repo-local assistant config: machine-local, never distributable content.
.codex/
.claude/

# Generated / transient
node_modules/
dist/
artifacts/
tests/.tmp/
.setup/
.DS_Store
.mcp.json

# Generated output from the visual skills (/table, /diagram, /figure).
.exports/

# Per-work-item docs (Throughline + ExecPlan + related): local working state.
.tasks/
# Legacy name for .tasks/ — keeps stale local copies on other machines ignored.
feature_requests/

# Personal self-profile: local-only, generated from "Chris's Brain" via /sync-self.
canonical/PROFILE.md

# Only the *.example.* templates under canonical/config/ are tracked. A filled-in
# copy holds personal absolute paths and secrets — it stays local.
canonical/config/*
!canonical/config/*.example.*

# Machine rules are local-only (ADR-0003) — they describe a real box; never commit them.
canonical/machines/*/rules.md

# Machine-scoped skills: only the work laptop's are local-only (it can't push).
# Other machines' skills stay tracked; the .gitkeep keeps work/skills/ on clone.
canonical/machines/work/skills/*
!canonical/machines/work/skills/.gitkeep
