# Toolkit environment knobs — runtime config the canonical hooks read.
#
# Nothing here is required. Every knob has a working default, listed below as
# the commented-out value. Set one only to change that default.
#
# These are ENVIRONMENT variables, not a file the hooks read — exporting them
# from your shell profile (or a per-session `VAR=x claude`) is what takes
# effect. This file is the reference for what exists, since the values live in
# hook source otherwise.

# --- Hook toggles -----------------------------------------------------------
# Each hook is on by default and turns off for a session with "0".

# Re-injects the DevOS Throughline steering context. (canonical-sync sibling)
#CLAUDE_DEVOS_STEERING=0

# Appends timestamped debug lines proving the steering hook fired.
# Opt-IN — set to "1" to enable, unlike the toggles above.
#CLAUDE_DEVOS_STEERING_DEBUG=1

# Re-injects the Lexicon recency nudge.
#CLAUDE_LEXICON_REMINDER=0

# Re-injects the Quick Recap / status-line nudge.
#CLAUDE_QUICK_RECAP_REMINDER=0

# Re-injects the ship-mode posture nudge.
#CLAUDE_SHIP_MODE_REMINDER=0

# Enables the /quiz-me session hook.
#CLAUDE_QUIZ_ME=0

# Keeps Target Projections in sync with the Canonical Assistant Source.
#CANONICAL_SYNC=0

# --- Thresholds and paths ---------------------------------------------------

# Tool calls before strategic-compact suggests compacting.
# Must be a positive integer; anything else falls back to the default.
#COMPACT_THRESHOLD=50

# Seconds claude-notify waits before firing, so short turns stay silent.
#NOTIFY_DEBOUNCE_SEC=45

# Where claude-notify keeps its activity stamps.
#NOTIFY_RUN_DIR=~/.claude/run

# Pushover credentials for claude-notify (PUSHOVER_TOKEN + PUSHOVER_USER).
# Copy secrets-pushover.example.env to this path and fill it in; without both
# keys the hook falls back to a local banner only.
#PUSHOVER_SECRETS_FILE=~/.claude/secrets-pushover.env
