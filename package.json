{
  "name": "assistant-setup-toolkit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Canonical Assistant Source and Setup Wizard that configure Claude Code and Codex CLI consistently across machines.",
  "type": "module",
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "claude-ai": "tsx scripts/claude-ai-pack.ts",
    "loop-audit:extract": "tsx scripts/loop-audit.ts",
    "check-upstream": "tsx scripts/check-upstream.ts",
    "pins": "tsx scripts/pins.ts",
    "sync": "npm run setup -- --sync",
    "sync:watch": "chokidar 'canonical/**/*' 'manifests/**/*' -c 'npm run sync' --initial",
    "test": "vitest run",
    "test:watch": "vitest",
    "skills": "tsx scripts/skills-page.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "chokidar-cli": "^3.0.0",
    "playwright-core": "1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "jszip": "^3.10.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  }
}
